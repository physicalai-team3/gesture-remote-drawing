# cp .env.example .env  — 설명: docs/02-containers.md
# (주의: 값 뒤에 주석을 달지 마세요. 줄 단위 주석만 사용)

# ── A gateway ──
# 비우면 cloudflared /quicktunnel 자동 조회
PUBLIC_URL=
STAGE_TIMEOUT_MS=1000
TARGET_FPS=15
FRAME_WIDTH=480
JPEG_QUALITY=0.7
MAX_FRAME_BYTES=300000
SESSION_TTL_S=600

# ── B vision ──
# mediapipe | mock (mock = 가짜 손, A 개발용)
VISION_BACKEND=mediapipe
NUM_HANDS=1
MIN_DETECTION_CONF=0.5
MIN_TRACKING_CONF=0.5
# video (추적, 빠름) | image (매 프레임 검출)
RUNNING_MODE=video
MAX_SESSIONS=4
OMP_NUM_THREADS=2

# ── C gesture ──
DEBOUNCE_FRAMES=3
EXTEND_RATIO=1.15
LOST_HAND_MS=300
CLEAR_HOLD_MS=1500
JUMP_MAX=0.25
MIN_MOVE=0.003
ONE_EURO_MIN_CUTOFF=1.0
ONE_EURO_BETA=0.02
